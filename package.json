{
  "name": "kehikko-workitem",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Work item: one issue, merge request or pull request shown in full, read through the host's tracker reading with the person's own sign-ins. An app: its own page, its own port.",
  "scripts": {
    "dev": "vite",
    "build": "bun run build.ts",
    "start": "bun run serve.ts",
    "register": "bun run register.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "rows": "bun run dev/rows.ts",
    "check:rows": "kehikot-check-rows",
    "check:door": "kehikot-check-door .",
    "check:parts": "kehikot-check-parts ."
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-tooltip": "^1.2.16",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.33.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "kehikot-module-protocol": "git+https://github.com/Jalez/kehikko-protocol.git#38ae10ed8941b4a0e1191ccc27a4cd4d5a76088b",
    "tailwind-merge": "^3.6.0",
    "zod": "^3.23.8",
    "micromark": "^4.0.2",
    "micromark-extension-gfm": "^3.0.0"
  },
  "devDependencies": {
    "@happy-dom/global-registrator": "^20.11.6",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/react": "^16.3.2",
    "@types/bun": "latest",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^5.1.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.7.0",
    "vite": "^7.2.4"
  }
}
